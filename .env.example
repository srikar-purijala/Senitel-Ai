# NEXUS AI - Environment Configuration Example

# Backend Settings
PROJECT_NAME="NEXUS AI"
API_V1_STR="/api"

# Database Configuration (PostgreSQL recommended, falls back to SQLite)
DATABASE_URL=postgresql://user:password@localhost:5432/nexus_db
# fallback: DATABASE_URL=sqlite:///nexus.db

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# CORS configuration (set to Vercel domain in production)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "https://your-vercel-app-domain.vercel.app"]

# Frontend Configuration (place in frontend/.env)
# VITE_API_BASE_URL=https://your-fastapi-backend.onrender.com/api
